# Production Environment for lacorona.site
DEBUG=False
SECRET_KEY=your-production-secret-key-change-this-now
ALLOWED_HOSTS=lacorona.site,www.lacorona.site,api.lacorona.site,localhost,127.0.0.1

# Database Configuration (PostgreSQL for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rmc_system_prod
DB_USER=rmc_user
DB_PASSWORD=your-secure-password
DB_HOST=your-postgres-host
DB_PORT=5432

# CORS Configuration - Allow frontend domain
CORS_ALLOWED_ORIGINS=https://lacorona.site,https://www.lacorona.site,http://localhost:3000,http://127.0.0.1:3000

# Email Configuration (SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@lacorona.site

# JWT Token Configuration
JWT_ACCESS_TOKEN_LIFETIME=86400
JWT_REFRESH_TOKEN_LIFETIME=604800

# Application URLs
APP_URL=https://lacorona.site
API_URL=https://api.lacorona.site/api

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
