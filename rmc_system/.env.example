# Django Settings (Production)
DEBUG=False
SECRET_KEY=generate-a-new-random-secret-key-for-production
ALLOWED_HOSTS=lacorona.site,www.lacorona.site,api.lacorona.site,localhost

# Database Configuration (PostgreSQL recommended for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rmc_system_prod
DB_USER=rmc_user
DB_PASSWORD=your-secure-database-password
DB_HOST=your-postgres-host-or-ip
DB_PORT=5432

# CORS Configuration (Frontend domains)
CORS_ALLOWED_ORIGINS=https://lacorona.site,https://www.lacorona.site,http://localhost:3000

# Email Configuration (SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@lacorona.site

# JWT Token Configuration
JWT_ACCESS_TOKEN_LIFETIME=86400
JWT_REFRESH_TOKEN_LIFETIME=604800

# Application URLs
APP_URL=https://lacorona.site
API_URL=https://api.lacorona.site/api

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
